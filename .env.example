# CoinDCX (crypto broker) — coindcx.com → Profile → API Keys
COINDCX_API_KEY=
COINDCX_API_SECRET=

# Upstox (Indian equity + F&O broker) — only needed if ENABLE_INDIA=true
UPSTOX_API_KEY=
UPSTOX_ACCESS_TOKEN=

# Telegram bot — @BotFather for token; getUpdates for chat IDs
TELEGRAM_TOKEN=
TELEGRAM_CRYPTO_CHAT_ID=
TELEGRAM_INDIA_CHAT_ID=

# CoinGlass (on-chain data) — coinglass.com → Dashboard → API
COINGLASS_API_KEY=

# Mode
PAPER_TRADING=true
ENABLE_INDIA=false
STRATEGY_PROFILE=balanced
