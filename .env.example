# ── Upstox (Indian broker — required for live price data) ───────────────────
# Get from: app.upstox.com → My Account → Apps → Create API App
UPSTOX_API_KEY=
# Refreshed every day — see daily refresh instructions below
UPSTOX_ACCESS_TOKEN=

# ── News / Market Data ───────────────────────────────────────────────────────
# Free tier at marketaux.com → 100 req/day (sign up, get API key from dashboard)
MARKETAUX_API_KEY=

# ── Telegram (optional — disconnected in auto-execute mode) ─────────────────
# Only needed if you re-enable Telegram signal notifications
# Token from: t.me/BotFather → /newbot
TELEGRAM_TOKEN=
# Chat ID: add bot to group, then api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_INDIA_CHAT_ID=
# Your user ID from: t.me/userinfobot
TELEGRAM_ALLOWED_USER_IDS=

# ── Zerodha (optional — requires Kite Connect subscription ~2000/mo) ─────────
# Only fill if you subscribe at kite.trade/connect
# Daily token refresh: python scripts/kite_auth.py
ZERODHA_API_KEY=
ZERODHA_API_SECRET=
ZERODHA_ACCESS_TOKEN=

# ── Trading mode ─────────────────────────────────────────────────────────────
PAPER_TRADING=true
ENABLE_INDIA=true
ENABLE_INTRADAY=true
ENABLE_POSITIONAL=true

# ── Strategy ─────────────────────────────────────────────────────────────────
STRATEGY_PROFILE=balanced
ENABLE_LLM_ADJUDICATION=true

# ── India options ─────────────────────────────────────────────────────────────
# Leave blank to auto-calculate next Thursday expiry
INDIA_OPTIONS_EXPIRY=
INDIA_VIX_GATE=25.0
INTRADAY_FORCE_EXIT=15:15
POSITIONAL_MAX_DAYS=5

# ── Dashboard ────────────────────────────────────────────────────────────────
DASHBOARD_HOST=127.0.0.1
DASHBOARD_PORT=5000
